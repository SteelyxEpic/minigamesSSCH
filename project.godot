; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="minigames"
run/main_scene="res://start_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
AudioSettings="*res://audio_settings.gd"

[dialogue_manager]

runtime/balloon_path="res://dialogue_balloon.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/afaz-services-system/plugin.cfg", "res://addons/afaz-tools-ui-system/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

[gui]

theme/custom_font="res://PixelifySans-VariableFont_wght.ttf"

[internationalization]

locale/translations_pot_files=PackedStringArray("res://intro.dialogue", "res://mooner.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
