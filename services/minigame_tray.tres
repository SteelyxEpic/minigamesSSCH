[gd_resource type="Resource" script_class="TrayDefinition" format=3]

[ext_resource type="Script" path="res://addons/afaz-tools-ui-system/core/tray_definition.gd" id="1_tray"]
[ext_resource type="Script" path="res://addons/afaz-tools-ui-system/core/tool_definition.gd" id="2_tool"]
[ext_resource type="PackedScene" path="res://mission_planner.tscn" id="3_planner"]
[ext_resource type="PackedScene" path="res://mission_control.tscn" id="4_mission"]

[sub_resource type="Resource" id="Resource_planner"]
script = ExtResource("2_tool")
display_name = "Mission Planner"
description = "Choose power, fuel, supplies and instruments, then launch."
scene = ExtResource("3_planner")
keywords = Array[String](["mission", "planner", "launch", "power", "fuel"])

[sub_resource type="Resource" id="Resource_mission"]
script = ExtResource("2_tool")
display_name = "Mission Control"
description = "Pick instruments and run a set of minigames."
scene = ExtResource("4_mission")
keywords = Array[String](["mission", "instruments", "minigames", "science"])

[resource]
script = ExtResource("1_tray")
display_name = "Tools"
description = "Open a tool"
tools = Array[ExtResource("2_tool")]([SubResource("Resource_planner"), SubResource("Resource_mission")])
